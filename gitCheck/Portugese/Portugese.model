        <focus-ctd-trigger appliance="ALWAYS" is_or="false" name="test step-16" negative="false" suppressNewLine="false" triggerType="Test_Steps">
            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Criar uma fatura de fornecedor no sistema Basware com a moeda do documento definida como EUR e o fornecedor localizado no Egito."/>
                    <focus-ctd-template text="Verificar se o sistema preenche automaticamente os campos &quot;Moeda de Pagamento&quot; e &quot;Valor em Moeda de Pagamento&quot; com o valor em EGP equivalente."/>
                    <focus-ctd-template text="Alterar a &quot;Moeda de Pagamento&quot; para EUR, contrariando a configurao padro do sistema para pagamento em moeda local."/>
                    <focus-ctd-template text="Tentar processar o pagamento com a configurao alterada."/>
                    <focus-ctd-template text="Verificar a mensagem de erro exibida pelo sistema devido  alterao na moeda de pagamento."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="O sistema deve preencher automaticamente os campos &quot;Moeda de Pagamento&quot; e &quot;Valor em Moeda de Pagamento&quot; com o valor em EGP equivalente."/>
                    <focus-ctd-template text="Ao alterar a &quot;Moeda de Pagamento&quot; para EUR e tentar processar o pagamento, o sistema deve exibir uma mensagem de erro indicando que a moeda de pagamento no  suportada para o fornecedor e pas especificados ou permitir o processamento se a configurao permitir pagamento em EUR."/>
                    <focus-ctd-template text="O sistema no deve gerar o arquivo de pagamento se a moeda de pagamento no for suportada."/>
                    <focus-ctd-template text="O sistema deve manter a fatura em um estado de erro ou pendente, aguardando correo, se a moeda de pagamento no for suportada."/>
                    <focus-ctd-template text="A mensagem de erro deve ser clara e indicar a causa do problema."/>
                </focus-ctd-multiple-template-expectedResults>
                <focus-ctd-multiple-template-additionalInfo/>
            </focus-ctd-multiple-template>

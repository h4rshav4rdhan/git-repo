                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="O usurio empresarial cria uma solicitao de adiantamento de dinheiro na ferramenta MXP e seleciona a moeda necessria."/>
                    <focus-ctd-template text="O gerente de linha aprova a solicitao de adiantamento de dinheiro no MXP."/>
                    <focus-ctd-template text="O usurio empresarial solicita dinheiro ao Caixa com base na solicitao aprovada."/>
                    <focus-ctd-template text="O Caixa fornece dinheiro ao usurio empresarial e solicita ao RTR para registrar o Lanamento de Caixa no Dirio usando o aplicativo Fiori."/>
                    <focus-ctd-template text="O RTR registra o Lanamento de Caixa no Dirio contra a conta suspensa relevante."/>
                    <focus-ctd-template text="O usurio empresarial fornece recibos para o valor gasto na ferramenta MXP."/>
                    <focus-ctd-template text="O especialista em processamento de faturas lana a fatura do fornecedor no sistema."/>
                    <focus-ctd-template text="A equipe de Processamento de Faturas reconcilia o saldo na conta de suspenso com o lanamento da fatura."/>
                    <focus-ctd-template text="O administrador do RTR compensa o saldo na conta GL."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="A solicitao de adiantamento de dinheiro  criada com sucesso e est visvel no MXP."/>
                    <focus-ctd-template text="A solicitao de adiantamento de dinheiro  aprovada e o status  atualizado para &quot;Aprovado&quot;."/>
                    <focus-ctd-template text="O Caixa recebe a notificao da solicitao aprovada e fornece dinheiro ao usurio empresarial."/>
                    <focus-ctd-template text="O Caixa solicita ao RTR para registrar o Lanamento de Caixa no Dirio e o RTR recebe a solicitao."/>
                    <focus-ctd-template text="O Lanamento de Caixa no Dirio  registrado com sucesso no aplicativo Fiori com a mensagem &quot;Lanamento de Caixa no Dirio registrado com sucesso&quot;."/>
                    <focus-ctd-template text="O valor gasto  refletido no arquivo contbil MXP com o status &quot;Processado&quot;."/>
                    <focus-ctd-template text="A fatura do fornecedor  lanada no sistema com o status &quot;Lanado&quot;."/>
                    <focus-ctd-template text="O saldo na conta de suspenso  reconciliado com o lanamento da fatura e o status  atualizado para &quot;Reconciliado&quot;."/>
                    <focus-ctd-template text="O saldo na conta GL  compensado com sucesso e o status  atualizado para &quot;Compensado&quot;."/>
                </focus-ctd-multiple-template-expectedResults>
                <focus-ctd-multiple-template-additionalInfo/>

            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Receber a fatura do fornecedor via Edicom no sistema Basware."/>
                    <focus-ctd-template text="Verificar se a fatura recebida est com o tipo de fatura &quot;recebida&quot; e com a moeda &quot;USD&quot;."/>
                    <focus-ctd-template text="Aprovar a fatura no sistema Basware."/>
                    <focus-ctd-template text="Solicitar o pagamento em dinheiro para o fornecedor."/>
                    <focus-ctd-template text="Registrar o pagamento em dinheiro no sistema Fiori."/>
                    <focus-ctd-template text="Verificar se o pagamento foi registrado corretamente no sistema Fiori."/>
                    <focus-ctd-template text="Verificar se o adiantamento de caixa foi processado corretamente."/>
                    <focus-ctd-template text="Verificar se o saldo da conta de suspenso foi reconciliado com o lanamento da fatura."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="A fatura  recebida corretamente no sistema Basware via Edicom e exibida na lista de faturas recebidas."/>
                    <focus-ctd-template text="A fatura est com o tipo &quot;recebida&quot; e moeda &quot;USD&quot; e  exibida nos detalhes da fatura."/>

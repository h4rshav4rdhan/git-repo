            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="O usurio empresarial solicita a aprovao do pagamento para o fornecedor com uma fatura recebida da Edicom."/>
                    <focus-ctd-template text="O sistema registra a solicitao de pagamento e envia para aprovao."/>
                    <focus-ctd-template text="Aps a aprovao, o usurio empresarial solicita ao caixa que fornea o dinheiro."/>
                    <focus-ctd-template text="O caixa fornece o dinheiro e solicita ao RTR que registre o Lanamento de Caixa no Dirio usando o aplicativo Fiori."/>
                    <focus-ctd-template text="O RTR registra o Lanamento de Caixa no Dirio contra a conta suspensa relevante."/>
                    <focus-ctd-template text="A equipe de Processamento de Faturas reconcilia o saldo na conta suspensa com o lanamento da fatura."/>
                    <focus-ctd-template text="O sistema gera um arquivo de pagamento no formato MT101 para o banco BNP."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="O sistema exibe uma mensagem de confirmao de que a solicitao de pagamento foi registrada com sucesso."/>
                    <focus-ctd-template text="O sistema atualiza o status do pagamento para &quot;aprovado&quot; e notifica o usurio empresarial."/>
                    <focus-ctd-template text="O sistema exibe a solicitao de pagamento aprovada para o caixa."/>
                    <focus-ctd-template text="O sistema registra o Lanamento de Caixa no Dirio com sucesso e exibe uma mensagem de confirmao."/>
                    <focus-ctd-template text="O sistema atualiza o saldo na conta suspensa relevante."/>
                    <focus-ctd-template text="O sistema exibe uma mensagem de confirmao de que o saldo na conta suspensa foi reconciliado com sucesso."/>
                    <focus-ctd-template text="O sistema gera um arquivo de pagamento no formato MT101 para o banco BNP e exibe uma mensagem de confirmao."/>
                </focus-ctd-multiple-template-expectedResults>
                <focus-ctd-multiple-template-additionalInfo/>
            </focus-ctd-multiple-template>
